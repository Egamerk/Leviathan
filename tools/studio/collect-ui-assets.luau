--[[
	Collect every asset id used by the selected UI into one ModuleScript.

	How to use (Roblox Studio):
	  1. Select the ScreenGui(s) or Folder(s) that hold the combat UI.
	  2. Paste this whole file into the Command Bar (View → Command Bar) and press Enter.
	  3. A ModuleScript "UiAssetIds" appears in ServerStorage, holding every
	     image/sound id keyed by its path in the UI tree. Its Source is selected
	     for you; copy it, or right-click it → Save to File.

	Nothing in your UI is modified.
]]

local Selection = game:GetService("Selection")
local ServerStorage = game:GetService("ServerStorage")

local PROPERTIES = {
	ImageLabel = { "Image" },
	ImageButton = { "Image", "HoverImage", "PressedImage" },
	Decal = { "Texture" },
	Texture = { "Texture" },
	Sound = { "SoundId" },
	MeshPart = { "TextureID" },
}

local roots = Selection:Get()
assert(#roots > 0, "Select the UI ScreenGui(s) first")

local lines, seen, count = {}, {}, 0
local function visit(instance, root)
	local props = PROPERTIES[instance.ClassName]
	if props then
		for _, prop in props do
			local id = instance[prop]
			if id ~= "" then
				local path = instance:GetFullName():sub(#root.Parent:GetFullName() + 2)
				-- Primary properties use the bare path; secondary ones get a suffix.
				local isPrimary = prop == "Image" or prop == "Texture" or prop == "SoundId" or prop == "TextureID"
				local key = if isPrimary then path else path .. "." .. prop
				if not seen[key] then
					seen[key] = true
					count += 1
					table.insert(lines, string.format("\t[%q] = %q, -- %s", key, id, instance.ClassName))
				end
			end
		end
	end
	for _, child in instance:GetChildren() do
		visit(child, root)
	end
end

for _, root in roots do
	visit(root, root)
end
table.sort(lines)

local module = ServerStorage:FindFirstChild("UiAssetIds") or Instance.new("ModuleScript")
module.Name = "UiAssetIds"
module.Source = "-- Generated by tools/studio/collect-ui-assets.luau\nreturn {\n" .. table.concat(lines, "\n") .. "\n}\n"
module.Parent = ServerStorage
Selection:Set({ module })
print(string.format("[collect-ui-assets] %d asset ids written to ServerStorage.UiAssetIds", count))
