            <string name="Name">profile</string>
            <string name="Source"><![CDATA[-- Compiled with roblox-ts v3.0.0
local TS = require(game:GetService("ReplicatedStorage"):WaitForChild("rbxts_include"):WaitForChild("RuntimeLib"))
local ProfileStore = TS.import(script, game:GetService("ReplicatedStorage"), "rbxts_include", "node_modules", "@rbxts", "profile-store", "src")
local _services = TS.import(script, game:GetService("ReplicatedStorage"), "rbxts_include", "node_modules", "@rbxts", "services")
local Players = _services.Players
local RunService = _services.RunService
local _components = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "ecs", "components")
local Dummy = _components.Dummy
local Guid = _components.Guid
local Money = _components.Money
local Name = _components.Name
local OwnerUserId = _components.OwnerUserId
local Persistent = _components.Persistent
local Player = _components.Player
local UserId = _components.UserId
local gameBus = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "ecs", "bus").gameBus
local world = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "ecs", "world").world
local createGuid = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "util").createGuid
local PROFILE_TEMPLATE = {
	version = 1,
	money = 100,
	entities = {},
	regions = {},
}
local playerStore = ProfileStore.New("PlayerData", PROFILE_TEMPLATE)
local dataStore = if RunService:IsStudio() then playerStore.Mock else playerStore
local sessions = {}
local entitiesByGuid = {}
local function getProfile(player)
	local _userId = player.UserId
	local _result = sessions[_userId]
	if _result ~= nil then
		_result = _result.profile
	end
	return _result
end
local function getSession(userId)
	local _userId = userId
	return sessions[_userId]
end
local function getEntityByGuid(guid)
	local _guid = guid
	return entitiesByGuid[_guid]
end
local function getOrCreateDummy(profile)
	for _, saved in pairs(profile.Data.entities) do
		if saved.kind == "dummy" then
			return saved
		end
	end
	local guid = createGuid()
	local dummy = {
		guid = guid,
		kind = "dummy",
		components = {
			money = profile.Data.money,
		},
	}
	profile.Data.entities[guid] = dummy
	return dummy
end
local function destroySession(userId)
	local _userId = userId
	local session = sessions[_userId]
	if session == nil then
		return nil
	end
	gameBus:publish("EntityDespawned", {
		userId = userId,
		guid = session.dummyGuid,
	})
	local _dummyGuid = session.dummyGuid
	entitiesByGuid[_dummyGuid] = nil
	if world:contains(session.dummyEntity) then
		world:delete(session.dummyEntity)
	end
	if world:contains(session.playerEntity) then
		world:delete(session.playerEntity)
	end
	local _userId_1 = userId
	sessions[_userId_1] = nil
end
local function loadPlayer(player)
	local profile = dataStore:StartSessionAsync(`Player_{player.UserId}`, {
		Cancel = function()
			return player.Parent ~= Players
		end,
	})
	if profile == nil then
		player:Kick("Failed to load data. Please rejoin.")
		return nil
	end
	profile:AddUserId(player.UserId)
	profile:Reconcile()
	profile.OnSessionEnd:Connect(function()
		destroySession(player.UserId)
		if player.Parent == Players then
			player:Kick("Your data session ended. Please rejoin.")
		end
	end)
	if player.Parent ~= Players then
		profile:EndSession()
		return nil
	end
	local dummySave = getOrCreateDummy(profile)
	local _condition = dummySave.components.money
	if _condition == nil then
		_condition = profile.Data.money
	end
	local money = _condition
	profile.Data.money = money
	local playerEntity = world:entity()
	world:add(playerEntity, Player)
	world:set(playerEntity, UserId, player.UserId)
	world:set(playerEntity, Name, player.Name)
	local dummyEntity = world:entity()
	world:add(dummyEntity, Dummy)
	world:add(dummyEntity, Persistent)
	world:set(dummyEntity, Guid, dummySave.guid)
	world:set(dummyEntity, OwnerUserId, player.UserId)
	world:set(dummyEntity, Money, money)
	local session = {
		player = player,
		profile = profile,
		playerEntity = playerEntity,
		dummyEntity = dummyEntity,
		dummyGuid = dummySave.guid,
	}
	local _userId = player.UserId
	sessions[_userId] = session
	local _guid = dummySave.guid
	entitiesByGuid[_guid] = dummyEntity
	gameBus:publish("EntitySpawned", {
		userId = player.UserId,
		guid = dummySave.guid,
		entity = dummyEntity,
		kind = "dummy",
	})
	gameBus:publish("PlayerLoaded", {
		player = player,
		userId = player.UserId,
		playerEntity = playerEntity,
		dummyEntity = dummyEntity,
		guid = dummySave.guid,
		money = money,
	})
end
local function unloadPlayer(player)
	local _userId = player.UserId
	local session = sessions[_userId]
	if session == nil then
		return nil
	end
	-- The bus is synchronous: persistence writes the latest ECS state before
	-- EndSession performs ProfileStore's final save.
	gameBus:publish("SaveRequested", {
		userId = player.UserId,
	})
	session.profile:EndSession()
	destroySession(player.UserId)
end
return {
	getProfile = getProfile,
	getSession = getSession,
	getEntityByGuid = getEntityByGuid,
	loadPlayer = loadPlayer,
	unloadPlayer = unloadPlayer,
}
]]></string>
