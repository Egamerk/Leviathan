            <string name="Name">bus</string>
            <string name="Source"><![CDATA[-- Compiled with roblox-ts v3.0.0
--* Synchronous typed event bus. Systems publish facts instead of calling each other. 
local EventBus
do
	EventBus = setmetatable({}, {
		__tostring = function()
			return "EventBus"
		end,
	})
	EventBus.__index = EventBus
	function EventBus.new(...)
		local self = setmetatable({}, EventBus)
		return self:constructor(...) or self
	end
	function EventBus:constructor()
		self.listeners = {}
	end
	function EventBus:subscribe(event, handler)
		local _listeners = self.listeners
		local _event = event
		local _condition = _listeners[_event]
		if _condition == nil then
			_condition = {}
		end
		local listeners = _condition
		local listener = function(payload)
			return handler(payload)
		end
		table.insert(listeners, listener)
		local _listeners_1 = self.listeners
		local _event_1 = event
		_listeners_1[_event_1] = listeners
		return function()
			local index = (table.find(listeners, listener) or 0) - 1
			if index ~= -1 then
				table.remove(listeners, index + 1)
			end
		end
	end
	function EventBus:publish(event, payload)
		local _listeners = self.listeners
		local _event = event
		local listeners = _listeners[_event]
		if listeners == nil then
			return nil
		end
		local _array = {}
		local _length = #_array
		table.move(listeners, 1, #listeners, _length + 1, _array)
		for _, listener in _array do
			listener(payload)
		end
	end
end
local gameBus = EventBus.new()
return {
	gameBus = gameBus,
}
]]></string>
          </Properties>
