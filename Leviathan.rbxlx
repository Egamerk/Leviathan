            <string name="Name">replication</string>
            <string name="Source"><![CDATA[-- Compiled with roblox-ts v3.0.0
local TS = require(game:GetService("ReplicatedStorage"):WaitForChild("rbxts_include"):WaitForChild("RuntimeLib"))
local Players = TS.import(script, game:GetService("ReplicatedStorage"), "rbxts_include", "node_modules", "@rbxts", "services").Players
local Net = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "net", "client").default
local assertPlayerDelta = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "net", "validators").assertPlayerDelta
local applyMoneyDelta = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "state", "players").applyMoneyDelta
--* Validates server deltas at the client boundary and updates Charm mirrors. 
local function startReplicationController()
	local localPlayer = Players.LocalPlayer
	Net.replicatePlayer.setCallback(function(untrustedDelta)
		local delta = assertPlayerDelta(untrustedDelta)
		applyMoneyDelta(localPlayer.UserId, delta.money)
	end)
	Net.ready.fire()
	task.spawn(function()
		local ping = Net.getPing.call()
		print(`[client] ping returned {ping}`)
	end)
end
return {
	startReplicationController = startReplicationController,
}
]]></string>
          </Properties>
