          <Item class="ModuleScript" referent="22">
            <Properties>
              <string name="Name">player</string>
              <string name="Source"><![CDATA[-- Compiled with roblox-ts v3.0.0
local TS = require(game:GetService("ReplicatedStorage"):WaitForChild("rbxts_include"):WaitForChild("RuntimeLib"))
local Name = TS.import(script, game:GetService("ReplicatedStorage"), "rbxts_include", "node_modules", "@rbxts", "jecs", "src", "jecs").Name
local world = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "ecs", "world").world
--* Tag: entity represents a live Roblox player session. 
local Player = world:entity()
--* Roblox UserId for a player entity. 
local UserId = world:component()
--[[
	*
	 * Stable persistence identifier. Generated once at spawn and stored in the
	 * player's profile. Never persist raw jecs entity ids — they are recycled.
	 
]]
local Guid = world:component()
--* Server-authoritative currency balance. 
local Money = world:component()
--* Tag: entity's state should be written to ProfileStore. 
local Persistent = world:entity()
--* Tag: entity is the player's own persistent dummy (round-trip demo). 
local Dummy = world:entity()
--* Owner of an entity (the player's UserId) for replication routing. 
local OwnerUserId = world:component()
return {
	Name = Name,
	Player = Player,
	UserId = UserId,
	Guid = Guid,
	Money = Money,
	Persistent = Persistent,
	Dummy = Dummy,
	OwnerUserId = OwnerUserId,
}
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">queries</string>
            <string name="Source"><![CDATA[-- Compiled with roblox-ts v3.0.0
local TS = require(game:GetService("ReplicatedStorage"):WaitForChild("rbxts_include"):WaitForChild("RuntimeLib"))
local _components = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "ecs", "components")
local Guid = _components.Guid
local Money = _components.Money
local OwnerUserId = _components.OwnerUserId
local Persistent = _components.Persistent
local Player = _components.Player
local UserId = _components.UserId
--* Iterate live player entities: [entity, userId]. 
local function playerEntities(world)
	return world:query(UserId):with(Player)
end
--* Iterate entities that must be written to ProfileStore: [entity, guid, ownerUserId]. 
local function persistentEntities(world)
	return world:query(Guid, OwnerUserId):with(Persistent)
end
--* Iterate entities with a Money balance and stable Guid: [entity, guid, money]. 
local function moneyEntities(world)
	return world:query(Guid, Money)
end
--* Find the player entity for a given UserId, or undefined. 
local function findPlayerEntity(world, userId)
	for entity, id in playerEntities(world) do
		if id == userId then
			return entity
		end
	end
	return nil
end
return {
	playerEntities = playerEntities,
	persistentEntities = persistentEntities,
	moneyEntities = moneyEntities,
	findPlayerEntity = findPlayerEntity,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">scheduler</string>
            <string name="Source"><![CDATA[-- Compiled with roblox-ts v3.0.0
local TS = require(game:GetService("ReplicatedStorage"):WaitForChild("rbxts_include"):WaitForChild("RuntimeLib"))
local _planck = TS.import(script, game:GetService("ReplicatedStorage"), "rbxts_include", "node_modules", "@rbxts", "planck", "out")
local Phase = _planck.Phase
local Pipeline = _planck.Pipeline
local Scheduler = _planck.Scheduler
local Plugin = TS.import(script, game:GetService("ReplicatedStorage"), "rbxts_include", "node_modules", "@rbxts", "planck-runservice", "out").Plugin
local RunService = TS.import(script, game:GetService("ReplicatedStorage"), "rbxts_include", "node_modules", "@rbxts", "services").RunService
local world = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "ecs", "world").world
--* Presentation and other frame-rate-dependent systems. 
local variableScheduler = Scheduler.new(world)
variableScheduler:addPlugin(Plugin.new())
--* Deterministic simulation systems (combat, status effects, AI decisions). 
local fixedScheduler = Scheduler.new(world)
--[[
	*
	 * Ordering contract for every fixed-step system:
	 * - `Input`: drain queued player/network intents into ECS.
	 * - `Resolve`: authoritative simulation (hits, timing windows, economy ticks).
	 * - `Effects`: apply resolved outcomes and publish facts on the bus.
	 * - `Cleanup`: expire timers, drop despawn markers, clear per-tick scratch.
	 
]]
local FixedPhases = {
	Input = Phase.new("Input"),
	Resolve = Phase.new("Resolve"),
	Effects = Phase.new("Effects"),
	Cleanup = Phase.new("Cleanup"),
}
local FixedPipeline = Pipeline.new("Fixed"):insert(FixedPhases.Input):insert(FixedPhases.Resolve):insert(FixedPhases.Effects):insert(FixedPhases.Cleanup)
-- No RunService event: the pipeline stays in the default group that `runAll` drives.
fixedScheduler:insert(FixedPipeline)
local FIXED_STEP = 1 / 30
local MAX_STEPS_PER_FRAME = 5
local fixedStepStarted = false
--* Starts a bounded accumulator to prevent a lag spike from causing a death spiral. 
local function startFixedStep()
	if fixedStepStarted then
		return nil
	end
	fixedStepStarted = true
	local accumulator = 0
	RunService.Heartbeat:Connect(function(deltaTime)
		accumulator = math.min(accumulator + deltaTime, FIXED_STEP * MAX_STEPS_PER_FRAME)
		local steps = 0
		while accumulator >= FIXED_STEP and steps < MAX_STEPS_PER_FRAME do
			fixedScheduler:runAll()
			accumulator -= FIXED_STEP
			steps += 1
		end
	end)
end
return {
	startFixedStep = startFixedStep,
	variableScheduler = variableScheduler,
	fixedScheduler = fixedScheduler,
	FixedPhases = FixedPhases,
	FixedPipeline = FixedPipeline,
	FIXED_STEP = FIXED_STEP,
}
]]></string>
          </Properties>
