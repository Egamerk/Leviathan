        <Item class="ModuleScript" referent="79">
          <Properties>
            <string name="Name">idleIncome</string>
            <string name="Source"><![CDATA[-- Compiled with roblox-ts v3.0.0
local TS = require(game:GetService("ReplicatedStorage"):WaitForChild("rbxts_include"):WaitForChild("RuntimeLib"))
local _components = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "ecs", "components")
local Dummy = _components.Dummy
local Guid = _components.Guid
local Money = _components.Money
local OwnerUserId = _components.OwnerUserId
local gameBus = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "ecs", "bus").gameBus
local FIXED_STEP = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "ecs", "scheduler").FIXED_STEP
local INCOME_INTERVAL = 5
local elapsedByGuid = {}
local function startIdleIncomeSystem()
	gameBus:subscribe("EntityDespawned", function(_param)
		local guid = _param.guid
		elapsedByGuid[guid] = nil
	end)
end
--* Fixed-step example gameplay system. It only mutates ECS and publishes facts. 
local function idleIncomeSystem(world)
	for entity, guid, ownerUserId, money in world:query(Guid, OwnerUserId, Money):with(Dummy) do
		local _condition = elapsedByGuid[guid]
		if _condition == nil then
			_condition = 0
		end
		local elapsed = _condition + FIXED_STEP
		if elapsed < INCOME_INTERVAL then
			elapsedByGuid[guid] = elapsed
			continue
		end
		local _arg1 = elapsed - INCOME_INTERVAL
		elapsedByGuid[guid] = _arg1
		local nextMoney = money + 1
		world:set(entity, Money, nextMoney)
		gameBus:publish("MoneyChanged", {
			userId = ownerUserId,
			guid = guid,
			money = nextMoney,
		})
	end
end
return {
	startIdleIncomeSystem = startIdleIncomeSystem,
	idleIncomeSystem = idleIncomeSystem,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="80">
          <Properties>
            <string name="Name">persistence</string>
            <string name="Source"><![CDATA[-- Compiled with roblox-ts v3.0.0
local TS = require(game:GetService("ReplicatedStorage"):WaitForChild("rbxts_include"):WaitForChild("RuntimeLib"))
local Money = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "ecs", "components").Money
local gameBus = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "ecs", "bus").gameBus
local world = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "ecs", "world").world
local getSession = TS.import(script, game:GetService("ServerScriptService"), "TS", "services", "profile").getSession
local function writeMoney(userId, guid, money)
	local session = getSession(userId)
	if session == nil or not session.profile:IsActive() then
		return nil
	end
	local saved = session.profile.Data.entities[guid]
	if saved == nil then
		return nil
	end
	saved.components.money = money
	session.profile.Data.money = money
end
--* Owns all ECS → ProfileStore writes. Gameplay systems never import ProfileStore. 
local function startPersistenceSystem()
	gameBus:subscribe("MoneyChanged", function(_param)
		local userId = _param.userId
		local guid = _param.guid
		local money = _param.money
		writeMoney(userId, guid, money)
	end)
	gameBus:subscribe("SaveRequested", function(_param)
		local userId = _param.userId
		local session = getSession(userId)
		if session == nil then
			return nil
		end
		local money = world:get(session.dummyEntity, Money)
		if money ~= nil then
			writeMoney(userId, session.dummyGuid, money)
		end
	end)
end
return {
	startPersistenceSystem = startPersistenceSystem,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="81">
          <Properties>
            <string name="Name">replication</string>
            <string name="Source"><![CDATA[-- Compiled with roblox-ts v3.0.0
local TS = require(game:GetService("ReplicatedStorage"):WaitForChild("rbxts_include"):WaitForChild("RuntimeLib"))
local Players = TS.import(script, game:GetService("ReplicatedStorage"), "rbxts_include", "node_modules", "@rbxts", "services").Players
local Money = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "ecs", "components").Money
local gameBus = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "ecs", "bus").gameBus
local world = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "ecs", "world").world
local Net = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "net", "server").default
local assertPlayerDelta = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "net", "validators").assertPlayerDelta
local _players = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "state", "players")
local applyMoneyDelta = _players.applyMoneyDelta
local applyPlayerSnapshot = _players.applyPlayerSnapshot
local removePlayerState = _players.removePlayerState
local getSession = TS.import(script, game:GetService("ServerScriptService"), "TS", "services", "profile").getSession
local readyPlayers = {}
local function replicate(userId, guid, money)
	local player = Players:GetPlayerByUserId(userId)
	local _condition = player == nil
	if not _condition then
		local _userId = userId
		_condition = not (readyPlayers[_userId] ~= nil)
	end
	if _condition then
		return nil
	end
	Net.replicatePlayer.fire(player, assertPlayerDelta({
		guid = guid,
		money = money,
	}))
end
--* The only server system that knows clients or Zap exist. 
local function startReplicationSystem()
	Net.getPing.setCallback(function()
		return math.floor(os.clock() * 1000) % 65536
	end)
	Net.ready.setCallback(function(player)
		local _userId = player.UserId
		readyPlayers[_userId] = true
		local session = getSession(player.UserId)
		if session == nil then
			return nil
		end
		local money = world:get(session.dummyEntity, Money)
		if money ~= nil then
			replicate(player.UserId, session.dummyGuid, money)
		end
	end)
	gameBus:subscribe("PlayerLoaded", function(_param)
		local userId = _param.userId
		local guid = _param.guid
		local money = _param.money
		applyPlayerSnapshot(userId, {
			money = money,
		})
		replicate(userId, guid, money)
	end)
	gameBus:subscribe("MoneyChanged", function(_param)
		local userId = _param.userId
		local guid = _param.guid
		local money = _param.money
		applyMoneyDelta(userId, money)
		replicate(userId, guid, money)
	end)
	gameBus:subscribe("EntityDespawned", function(_param)
		local userId = _param.userId
		removePlayerState(userId)
	end)
	Players.PlayerRemoving:Connect(function(player)
		local _userId = player.UserId
		readyPlayers[_userId] = nil
	end)
end
return {
	startReplicationSystem = startReplicationSystem,
}
]]></string>
