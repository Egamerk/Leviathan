        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">players</string>
            <string name="Source"><![CDATA[-- Compiled with roblox-ts v3.0.0
local TS = require(game:GetService("ReplicatedStorage"):WaitForChild("rbxts_include"):WaitForChild("RuntimeLib"))
local atom = TS.import(script, game:GetService("ReplicatedStorage"), "rbxts_include", "node_modules", "@rbxts", "charm", "src").atom
local DEFAULT_PLAYER_STATE = {
	money = 0,
}
--* Per-player reactive state keyed by UserId string. 
local playersAtom = atom({})
local function getPlayerState(userId)
	return playersAtom()[tostring(userId)] or DEFAULT_PLAYER_STATE
end
local function applyPlayerSnapshot(userId, state)
	playersAtom(function(current)
		local _object = table.clone(current)
		setmetatable(_object, nil)
		_object[tostring(userId)] = state
		return _object
	end)
end
local function applyMoneyDelta(userId, money)
	local key = tostring(userId)
	playersAtom(function(current)
		local _object = table.clone(current)
		setmetatable(_object, nil)
		local _left = key
		local _object_1 = table.clone((current[key] or DEFAULT_PLAYER_STATE))
		setmetatable(_object_1, nil)
		_object_1.money = money
		_object[_left] = _object_1
		return _object
	end)
end
local function removePlayerState(userId)
	playersAtom(function(current)
		local _object = table.clone(current)
		setmetatable(_object, nil)
		local updated = _object
		updated[tostring(userId)] = nil
		return updated
	end)
end
return {
	getPlayerState = getPlayerState,
	applyPlayerSnapshot = applyPlayerSnapshot,
	applyMoneyDelta = applyMoneyDelta,
	removePlayerState = removePlayerState,
	playersAtom = playersAtom,
}
]]></string>
