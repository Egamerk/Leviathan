              <string name="Source"><![CDATA[-- Compiled with roblox-ts v3.0.0
local TS = require(game:GetService("ReplicatedStorage"):WaitForChild("rbxts_include"):WaitForChild("RuntimeLib"))
local subscribe = TS.import(script, game:GetService("ReplicatedStorage"), "rbxts_include", "node_modules", "@rbxts", "charm", "src").subscribe
local moneyAtom = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "state", "money").moneyAtom
--* Temporary observable proving that replicated server state reaches Charm. 
local function startStateDebugController()
	subscribe(moneyAtom, function(money)
		print(`[client] mirrored money = {money}`)
	end)
end
return {
	startStateDebugController = startStateDebugController,
}
]]></string>
