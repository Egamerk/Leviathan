          <string name="Source"><![CDATA[-- Compiled with roblox-ts v3.0.0
local TS = require(game:GetService("ReplicatedStorage"):WaitForChild("rbxts_include"):WaitForChild("RuntimeLib"))
local Players = TS.import(script, game:GetService("ReplicatedStorage"), "rbxts_include", "node_modules", "@rbxts", "services").Players
local _scheduler = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "ecs", "scheduler")
local FixedPhases = _scheduler.FixedPhases
local fixedScheduler = _scheduler.fixedScheduler
local startFixedStep = _scheduler.startFixedStep
local variableScheduler = _scheduler.variableScheduler
local startPlayersService = TS.import(script, game:GetService("ServerScriptService"), "TS", "services", "players").startPlayersService
local _idleIncome = TS.import(script, game:GetService("ServerScriptService"), "TS", "systems", "idleIncome")
local idleIncomeSystem = _idleIncome.idleIncomeSystem
local startIdleIncomeSystem = _idleIncome.startIdleIncomeSystem
local startPersistenceSystem = TS.import(script, game:GetService("ServerScriptService"), "TS", "systems", "persistence").startPersistenceSystem
local startReplicationSystem = TS.import(script, game:GetService("ServerScriptService"), "TS", "systems", "replication").startReplicationSystem
-- Subscribers must exist before player profiles publish lifecycle events.
startPersistenceSystem()
startReplicationSystem()
startIdleIncomeSystem()
fixedScheduler:addSystem(idleIncomeSystem, FixedPhases.Resolve)
startFixedStep()
-- Retain the variable scheduler for future presentation/non-deterministic work.
local _arg0 = variableScheduler ~= nil
assert(_arg0)
startPlayersService()
print(`[server] Leviathan ready ({#Players:GetPlayers()} player(s) already in game)`)
]]></string>
