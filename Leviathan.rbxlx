      <Item class="LocalScript" referent="8">
        <Properties>
          <string name="Name">main</string>
          <string name="Source"><![CDATA[-- Compiled with roblox-ts v3.0.0
local TS = require(game:GetService("ReplicatedStorage"):WaitForChild("rbxts_include"):WaitForChild("RuntimeLib"))
local variableScheduler = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "ecs", "scheduler").variableScheduler
local startReplicationController = TS.import(script, script.Parent, "controllers", "replication").startReplicationController
local startStateDebugController = TS.import(script, script.Parent, "controllers", "stateDebug").startStateDebugController
-- Importing/retaining the variable scheduler starts Planck's RunService plugin.
-- Presentation systems can be registered on its explicit phases as they land.
local _arg0 = variableScheduler ~= nil
assert(_arg0)
startStateDebugController()
startReplicationController()
]]></string>
