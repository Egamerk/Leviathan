            <string name="Source"><![CDATA[-- Compiled with roblox-ts v3.0.0
--[[
	*
	 * Locked timings for a full boss/signature chain with cascading opens.
	 *
	 * - w0: longer hittable + full cold-start telegraph
	 * - w1: standard hittable + short telegraph (first live beat after predecessor)
	 * - w2: standard hittable, no telegraph (warm continuation)
	 
]]
local BASELINE_REACTION_WINDOWS = { {
	durationSeconds = 0.4,
	telegraphSeconds = 0.175,
	reaction = "parry",
}, {
	durationSeconds = 0.28,
	telegraphSeconds = 0.09,
	reaction = "dodge",
}, {
	durationSeconds = 0.28,
	telegraphSeconds = 0,
	reaction = "parry",
} }
--* Static authored data. Runtime cooldowns belong in ECS components. 
local ABILITY_DEFINITIONS = {
	basicAttack = {
		name = "Basic Attack",
		cooldownSeconds = 1,
	},
	bossSignatureChain = {
		name = "Boss Signature Chain",
		cooldownSeconds = 8,
		windows = BASELINE_REACTION_WINDOWS,
	},
}
return {
	BASELINE_REACTION_WINDOWS = BASELINE_REACTION_WINDOWS,
	ABILITY_DEFINITIONS = ABILITY_DEFINITIONS,
}
]]></string>
