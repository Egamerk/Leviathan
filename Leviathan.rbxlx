            <string name="Name">players</string>
            <string name="Source"><![CDATA[-- Compiled with roblox-ts v3.0.0
local TS = require(game:GetService("ReplicatedStorage"):WaitForChild("rbxts_include"):WaitForChild("RuntimeLib"))
local Players = TS.import(script, game:GetService("ReplicatedStorage"), "rbxts_include", "node_modules", "@rbxts", "services").Players
local _profile = TS.import(script, game:GetService("ServerScriptService"), "TS", "services", "profile")
local loadPlayer = _profile.loadPlayer
local unloadPlayer = _profile.unloadPlayer
local function startPlayersService()
	Players.PlayerAdded:Connect(function(player)
		task.spawn(function()
			return loadPlayer(player)
		end)
	end)
	Players.PlayerRemoving:Connect(function(player)
		unloadPlayer(player)
	end)
	for _, player in Players:GetPlayers() do
		task.spawn(function()
			return loadPlayer(player)
		end)
	end
end
return {
	startPlayersService = startPlayersService,
}
]]></string>
