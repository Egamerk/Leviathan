{
	"name": "Leviathan",
	"globIgnorePaths": ["**/package.json", "**/tsconfig.json", "**/*.zap"],
	"tree": {
		"$className": "DataModel",

		"ServerScriptService": {
			"$className": "ServerScriptService",
			"TS": {
				"$path": "out/server"
			}
		},

		"ReplicatedStorage": {
			"$className": "ReplicatedStorage",
			"rbxts_include": {
				"$path": "include",
				"node_modules": {
					"$className": "Folder",
					"@rbxts": {
						"$path": "node_modules/@rbxts"
					},
					"@rbxts-js": {
						"$path": "node_modules/@rbxts-js"
					},
					"@flamework": {
						"$path": "node_modules/@flamework"
					}
				}
			},
			"TS": {
				"$path": "out/shared"
			}
		},

		"StarterPlayer": {
			"$className": "StarterPlayer",
			"StarterPlayerScripts": {
				"$className": "StarterPlayerScripts",
				"TS": {
					"$path": "out/client"
				}
			}
		},

		"Workspace": {
			"$className": "Workspace",
			"$properties": {
				"FilteringEnabled": true
			},
			"Baseplate": {
				"$className": "Part",
				"$properties": {
					"Anchored": true,
					"Locked": true,
					"Color": [0.38823, 0.37254, 0.38823],
					"Position": [0, -10, 0],
					"Size": [512, 20, 512],
					"TopSurface": "Smooth",
					"BottomSurface": "Smooth"
				}
			},
			"SpawnLocation": {
				"$className": "SpawnLocation",
				"$properties": {
					"Anchored": true,
					"Duration": 0,
					"Neutral": true,
					"Position": [0, 1, 0],
					"Size": [12, 1, 12],
					"TopSurface": "Smooth",
					"BottomSurface": "Smooth"
				}
			}
		},

		"Lighting": {
			"$className": "Lighting",
			"$properties": {
				"Ambient": [0.4, 0.4, 0.4],
				"Brightness": 2,
				"GlobalShadows": true,
				"Outlines": false,
				"Technology": "ShadowMap"
			}
		},

		"HttpService": {
			"$className": "HttpService",
			"$properties": {
				"HttpEnabled": true
			}
		},

		"SoundService": {
			"$className": "SoundService",
			"$properties": {
				"RespectFilteringEnabled": true
			}
		}
	}
}
