{
  "name": "leviathan",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "zap": "zap src/shared/net/net.zap",
    "build": "npm run zap && rbxtsc && npm run clean:zap-out",
    "clean:zap-out": "node -e \"const fs=require('fs');const p='out/shared/net';if(fs.existsSync(p))for(const f of fs.readdirSync(p))if(f.startsWith('zap')||f.endsWith('.zap'))fs.unlinkSync(require('path').join(p,f));\"",
    "watch": "rbxtsc -w",
    "build:place": "rojo build -o Leviathan.rbxlx"
  },
  "license": "MIT",
  "devDependencies": {
    "@rbxts/compiler-types": "3.0.0-types.0",
    "@rbxts/types": "^1.0.952",
    "@typescript-eslint/eslint-plugin": "^8.9.0",
    "@typescript-eslint/parser": "^8.9.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-roblox-ts": "^0.0.36",
    "prettier": "^3.3.3",
    "roblox-ts": "^3.0.0",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@rbxts/charm": "^0.11.1",
    "@rbxts/charm-sync": "^0.4.1",
    "@rbxts/janitor": "^1.18.3-ts.0",
    "@rbxts/jecs": "^0.11.0",
    "@rbxts/planck": "^1.0.0",
    "@rbxts/planck-runservice": "^1.0.3",
    "@rbxts/profile-store": "^1.0.3",
    "@rbxts/react": "^17.3.13-ts.1",
    "@rbxts/react-roblox": "^17.3.13-ts.1",
    "@rbxts/ripple": "^0.10.2",
    "@rbxts/services": "^1.6.0",
    "@rbxts/t": "^3.2.1"
  }
}
